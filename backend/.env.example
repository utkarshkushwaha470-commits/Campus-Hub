# ==============================================================================
# CampusConnect - Environment Configuration (.env.example)
# ==============================================================================

# Project & College Institutional Settings
PROJECT_NAME="CampusConnect"
COLLEGE_NAME="Apex Institute of Technology"
COLLEGE_DOMAIN="apex.edu"

# Database Connection (PostgreSQL in production, SQLite fallback in dev)
# For local SQLite:
DATABASE_URL="sqlite:///./campusconnect.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/campusconnect"

# JWT & Authentication Secret
SECRET_KEY="campusconnect-super-secure-production-jwt-secret-key-32chars-min-!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Google Gemma 4 Multimodal AI Service Configuration
# ------------------------------------------------------------------------------
# All AI calls in CampusConnect route strictly through `app/services/ai_service.py`
# Gemma 4 assists with:
#   1. ID Card OCR & match hints (Admin decides final approval)
#   2. Question photo OCR, subject detection & tag generation
#   3. Advisory conceptual "AI Hint" button (clearly marked, 0 points)
#   4. PII-free confidential Problem Box urgency & safety screening
#
# To point to your Gemma 4 model server (Vertex AI / vLLM / HuggingFace TGI / Gemini):
GEMMA4_API_KEY="your-google-cloud-or-vertex-api-key"
GEMMA4_API_URL="https://api.google.com/gemma4/v1"
GEMMA4_MODEL_NAME="gemma-4-multimodal"

# ------------------------------------------------------------------------------
# S3-Compatible Storage Configuration
# ------------------------------------------------------------------------------
# Options: "local" (encrypted disk storage) or "s3" (AWS / MinIO / Cloudflare R2)
STORAGE_MODE="local"
S3_ENDPOINT_URL=""
S3_BUCKET_NAME="campusconnect-private"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# ------------------------------------------------------------------------------
# Moderation & Anti-Abuse Engine Limits
# ------------------------------------------------------------------------------
MAX_RATINGS_PER_DAY=5
MAX_RATINGS_PER_PAIR_PER_WEEK=2
BURST_RATING_WINDOW_SECONDS=180
